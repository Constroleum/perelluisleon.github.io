# ============================================================================
# OPTIMIZACIONES APACHE PARA GALERÍA DE ARTE - PERE LLUÍS LEÓN
# ============================================================================

# Habilitar reescritura de URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirigir de www a no-www
  RewriteCond %{HTTP_HOST} ^www\.perelluisleon\.art$ [NC]
  RewriteRule ^(.*)$ https://perelluisleon.art/$1 [R=301,L]
  
  # Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Redirigir URLs sin extensión
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ============================================================================
# COMPRESIÓN GZIP (Acelerar carga)
# ============================================================================

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
  
  # No comprimir imágenes ya comprimidas
  DeflateFilterNote Input instream
  DeflateFilterNote Output outstream
  DeflateFilterNote Ratio ratio
</IfModule>

# ============================================================================
# CACHÉ DEL NAVEGADOR (Browser Caching)
# ============================================================================

<IfModule mod_expires.c>
  ExpiresActive On
  
  # Archivos HTML - Cache corto (1 hora) para que se actualicen contenidos
  ExpiresByType text/html "access 1 hour"
  
  # Archivos CSS y JavaScript - Cache largo (1 año)
  ExpiresByType text/css "access 1 year"
  ExpiresByType application/javascript "access 1 year"
  ExpiresByType text/javascript "access 1 year"
  
  # Imágenes - Cache muy largo (1 mes)
  ExpiresByType image/jpeg "access 2592000 seconds"
  ExpiresByType image/gif "access 2592000 seconds"
  ExpiresByType image/png "access 2592000 seconds"
  ExpiresByType image/webp "access 2592000 seconds"
  ExpiresByType image/svg+xml "access 2592000 seconds"
  ExpiresByType image/x-icon "access 2592000 seconds"
  
  # Fuentes web - Cache largo (1 año)
  ExpiresByType font/ttf "access 1 year"
  ExpiresByType font/otf "access 1 year"
  ExpiresByType font/woff "access 1 year"
  ExpiresByType font/woff2 "access 1 year"
  
  # JSON-LD y otros datos
  ExpiresByType application/ld+json "access 1 day"
  ExpiresByType application/json "access 1 day"
  
  # Default
  ExpiresDefault "access 2 days"
</IfModule>

# ============================================================================
# CONTROL DE CACHÉ CON HEADERS
# ============================================================================

<IfModule mod_headers.c>
  # HTML - No cachear agresivamente
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  
  # Imágenes y recursos estáticos
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # JSON-LD y datos estruturados
  <FilesMatch "\.(json|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  
  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================================================
# BLOQUEAR ACCESO A ARCHIVOS SENSIBLES
# ============================================================================

<FilesMatch "\.(env|htaccess|json|xml|log|sql|txt|md)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Proteger directorios
<IfModule mod_authz_core.c>
  <DirectoryMatch "\.(git|svn)/">
    Order deny,allow
    Deny from all
  </DirectoryMatch>
</IfModule>

# ============================================================================
# MIME TYPES OPTIMIZADOS
# ============================================================================

<IfModule mod_mime.c>
  AddType application/json json
  AddType application/ld+json jsonld
  AddType image/svg+xml svg svgz
  AddType application/font-woff woff
  AddType application/font-woff2 woff2
  AddType application/vnd.ms-fontobject eot
  AddType font/ttf ttf
  AddType font/otf otf
  
  # WebP support
  AddType image/webp webp
</IfModule>

# ============================================================================
# REDIRECCIONAMIENTOS IMPORTANTES
# ============================================================================

# Redirigir páginas antiguas o refactorizadas
Redirect 301 /old-gallery /es/gallery.html
Redirect 301 /en/old-gallery /en/gallery.html
Redirect 301 /es/tienda /es/gallery.html

# Redirigir URLs sin trailing slash (opcional)
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]
</IfModule>
